{
  "name": "news-app",
  "version": "1.0.0",
  "description": "News app with PostgreSQL, TypeScript and Kysely",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "nodemon --exec ts-node src/server.ts",
    "db:init": "psql -U postgres -d news -f database-init.sql"
  },
  "dependencies": {
    "dotenv": "^10.0.0",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "kysely": "^0.26.3",
    "multer": "^1.4.4",
    "pg": "^8.14.1",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.13",
    "@types/multer": "^1.4.7",
    "@types/node": "^16.11.6",
    "@types/pg": "^8.6.5",
    "nodemon": "^2.0.14",
    "ts-node": "^10.4.0",
    "typescript": "^4.4.4"
  }
}
